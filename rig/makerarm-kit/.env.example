# Copy this file to .env and fill it in. Never commit .env.

# ── Arms ──
# One USB-CAN adapter (COM port) per arm. Find them with:  python first_move.py --list-ports
# Windows: COM9   macOS: /dev/cu.usbmodemXXXX   Linux: /dev/ttyACM0
ARM_PORTS=left=COM9,right=COM10
# Single-arm scripts (first_move.py, arm_server.py) use ARM_PORT; empty = auto-detect.
ARM_PORT=

# ── LiveKit: team control (web_app.py --livekit, remote.py) and arm_server.py / controller.py ──
# LiveKit Cloud -> your project -> Settings -> API Keys -> Create key.
# Teammates need these same four values; share them privately, never commit them.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=makerarm
