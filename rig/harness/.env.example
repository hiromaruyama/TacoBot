# Copy to .env (never commit it). These must match the SERVER laptop's upstream/.env,
# so the harness joins the same LiveKit project and room as `uv run robot` there.

# LiveKit Cloud (works from anywhere):
LIVEKIT_URL=wss://<your-project>.livekit.cloud
# ...or a livekit-server on the server laptop (`livekit-server --dev --bind 0.0.0.0`), same Wi-Fi:
# LIVEKIT_URL=ws://<server-laptop-ip>:7880

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=

# Optional: instead of the API key/secret, a token minted on the server laptop for identity "harness"
# (lets a teammate connect without the secret; --check needs the key/secret though).
# LIVEKIT_TOKEN=

# Optional: require this token from browsers/CLI when serving with --host 0.0.0.0
# HARNESS_TOKEN=
